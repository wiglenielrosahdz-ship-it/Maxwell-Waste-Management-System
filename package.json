{
  "name": "maxwell-waste-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered food waste tracking and reduction system",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "setup": "npm run docker:up && npm run backend:setup && npm run frontend:install",
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "backend:setup": "cd backend && npm install && npm run db:migrate && npm run db:seed",
    "backend:dev": "cd backend && npm run dev",
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "cd frontend && npm run dev",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "food-waste",
    "waste-tracking",
    "sustainability",
    "analytics",
    "dining-facilities"
  ],
  "author": "",
  "license": "MIT"
}
