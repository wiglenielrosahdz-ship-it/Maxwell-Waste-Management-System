# Database
DATABASE_URL="postgresql://maxwell_user:maxwell_password@localhost:5432/maxwell_waste_tracker"

# Server
NODE_ENV="development"
PORT=3000

# JWT
JWT_SECRET="your-256-bit-secret-key-change-in-production"
JWT_EXPIRES_IN="8h"

# Bcrypt
BCRYPT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Timezone
TIMEZONE="America/New_York"
